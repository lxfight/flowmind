# ========================================
# FlowMind 环境变量配置模板
# ========================================
# 复制此文件为 .env 并填入实际值
# 注意：.env 文件包含敏感信息，已被 .gitignore 排除，切勿提交到版本控制

# ----------------------------------------
# 数据库配置
# ----------------------------------------
# PostgreSQL 连接字符串（生产环境推荐）
# DATABASE_URL=postgresql+asyncpg://flowmind:your_password@localhost:5432/flowmind

# SQLite 连接字符串（开发环境）
DATABASE_URL=sqlite+aiosqlite:///./flowmind.db

# ----------------------------------------
# 安全配置
# ----------------------------------------
# JWT 密钥（生成方式：openssl rand -hex 32）
# 警告：更改此值会导致所有用户登录失效
JWT_SECRET=your_jwt_secret_key_here_64_characters_minimum_recommended

# 密码加密密钥（生成方式：openssl rand -hex 32）
# 警告：更改此值会导致所有密码失效
PASSWORD_SECRET_KEY=your_password_secret_key_here

# 集成配置加密密钥（用于加密第三方API token等敏感配置）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=your_fernet_encryption_key_here

# ----------------------------------------
# 管理员账户配置
# ----------------------------------------
# 初始管理员用户名（3-64字符，仅字母数字下划线点横线）
FLOWMIND_ADMIN_USERNAME=admin

# 初始管理员密码（8-128字符）
# 留空则自动生成随机密码并在启动时输出到控制台
FLOWMIND_ADMIN_PASSWORD=your_secure_admin_password

# ----------------------------------------
# LLM 配置
# ----------------------------------------
# LLM API 密钥（支持 OpenAI、Anthropic 等）
LLM_API_KEY=your_llm_api_key_here

# LLM API 基础 URL（可选，用于自定义端点）
# LLM_API_BASE=https://api.openai.com/v1

# LLM 模型名称（默认：gpt-4o）
# LLM_MODEL=gpt-4o

# ----------------------------------------
# Updater 服务配置
# ----------------------------------------
# Updater 服务认证令牌（用于自动更新功能）
# 生成方式：openssl rand -hex 32
FLOWMIND_UPDATER_TOKEN=your_updater_service_token_here

# ----------------------------------------
# 应用配置
# ----------------------------------------
# 前端 URL（用于 CORS 和回调）
FRONTEND_URL=http://localhost:5173

# 后端端口
PORT=8000

# 日志级别（DEBUG, INFO, WARNING, ERROR）
# LOG_LEVEL=INFO

# ----------------------------------------
# 通知配置（可选）
# ----------------------------------------
# SMTP 邮件服务器配置
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_email_password
# SMTP_FROM=noreply@flowmind.local

# ----------------------------------------
# 知识库配置（可选）
# ----------------------------------------
# 向量数据库配置（使用 pgvector 扩展）
# 默认使用 DATABASE_URL 中的数据库
# VECTOR_STORE=pgvector

# Embedding 模型配置
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_API_KEY=your_openai_api_key_for_embeddings
