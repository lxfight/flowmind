# ========================================
# FlowMind 环境变量配置模板
# ========================================
# 复制此文件为 .env 并填入实际值。
# .env 同时被 docker compose 和本地开发（pydantic-settings）读取。
# 注意：.env 包含敏感信息，已被 .gitignore 排除，切勿提交到版本控制。

# ========================================
# 一、容器编排与端口
# ========================================
# 镜像仓库地址（国内环境可改为镜像仓库前缀，如 docker.m.daocloud.io）
FLOWMIND_IMAGE_REGISTRY=ghcr.io

# 镜像标签 / 部署版本。updater 执行更新时会自动改写此值
# FLOWMIND_VERSION=0.5.0
FLOWMIND_VERSION=local

# 端口映射（宿主机端口:容器端口）
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=80

# 构建标识（可选，写入容器环境变量并显示在前端）
# GIT_SHA=
# BUILD_TIME=

# ========================================
# 二、数据库
# ========================================
# PostgreSQL 连接字符串（docker compose 环境下由 compose 文件提供）
# DATABASE_URL=postgresql+asyncpg://flowmind:flowmind_secret@postgres:5432/flowmind

# SQLite 连接字符串（仅本地开发直接运行后端时使用）
DATABASE_URL=sqlite+aiosqlite:///./flowmind_dev.db

# ========================================
# 三、安全配置
# ========================================
# JWT 签名密钥（生成方式：openssl rand -hex 32）
# 警告：更改此值会导致所有用户登录失效
JWT_SECRET=your_jwt_secret_key_here

# JWT 签名算法（默认 HS256，一般无需修改）
# JWT_ALGORITHM=HS256

# Access Token 有效期（分钟，默认 24 小时）
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 集成配置加密密钥，用于加密第三方 API token 等敏感配置
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 警告：更改此值会导致已保存的第三方集成凭证无法解密
INTEGRATION_ENCRYPTION_KEY=your_fernet_encryption_key_here

# ========================================
# 四、初始管理员账户
# ========================================
# 初始管理员用户名（3-64字符，仅字母数字下划线点横线）
FLOWMIND_ADMIN_USERNAME=admin

# 初始管理员密码（8-128字符）
# 留空则自动生成随机密码并在启动时输出到控制台
FLOWMIND_ADMIN_PASSWORD=your_secure_admin_password

# ========================================
# 五、后端应用配置
# ========================================
# 调试模式（开启后输出更多日志）
# DEBUG=false

# 应用时区（日志、提醒、LLM 助手的时间认知均使用此配置，默认 Asia/Shanghai）
APP_TIMEZONE=Asia/Shanghai

# 对外访问的基础 URL（用于 webhook 回调、通知中的链接）
# 留空时自动按请求推断
# PUBLIC_APP_URL=https://flowmind.example.com

# 文件上传目录（相对或绝对路径）
# UPLOAD_DIR=uploads

# 上传大小限制（字节）
# AVATAR_MAX_BYTES=2097152        # 头像上限 2MB
# KNOWLEDGE_MAX_BYTES=26214400    # 知识库文件上限 25MB

# 登录限流（同一 IP 单位窗口内允许的失败次数）
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_WINDOW=60

# 版本更新检查来源（GitHub 仓库，格式 owner/repo）
# RELEASE_REPOSITORY=lxfight/flowmind

# GitHub API Token（可选，提高 API 调用限额，避免 403）
# GITHUB_TOKEN=

# 更新检查结果缓存时长（秒，默认 6 小时）
# UPDATE_CHECK_TTL_SECONDS=21600

# ========================================
# 六、LLM 配置
# ========================================
# LLM API 密钥（支持 OpenAI、Anthropic 等兼容接口）
LLM_API_KEY=your_llm_api_key_here

# LLM API 基础 URL（可选，自定义端点 / 兼容服务）
# LLM_BASE_URL=https://api.openai.com/v1

# 对话模型名称
# LLM_MODEL=gpt-4o-mini

# 普通请求超时（秒）
# LLM_TIMEOUT=60

# 周报生成等长任务的超时 / 重试配置
# LLM_REPORT_TIMEOUT=180
# LLM_REPORT_MAX_RETRIES=2
# LLM_REPORT_RETRY_BASE_DELAY=1

# ========================================
# 七、Embedding 与知识库（RAG）配置
# ========================================
# Embedding 模型名称
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# 独立的 Embedding 端点凭证（可选；留空则复用 LLM_API_KEY / LLM_BASE_URL）
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# Embedding 调用鲁棒性配置
# EMBEDDING_TIMEOUT=30
# EMBEDDING_MAX_RETRIES=4
# EMBEDDING_RETRY_BASE_DELAY=2
# EMBEDDING_CONCURRENCY=2
# EMBEDDING_BATCH_SIZE=8

# Embedding 向量维度（pgvector 列宽的单一事实来源）
# 警告：更改此值需要对现有部署手动迁移列宽度
# LLM_EMBEDDING_DIM=1536

# 文档切块与检索配置
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K_RETRIEVAL=5
# SIMILARITY_THRESHOLD=0.35

# ========================================
# 八、Webhook 投递（notifier 服务）
# ========================================
# 单个请求超时（秒）
# WEBHOOK_REQUEST_TIMEOUT=10

# 轮询间隔（秒）
# WEBHOOK_WORKER_POLL_SECONDS=1

# 最大投递尝试次数
# WEBHOOK_MAX_ATTEMPTS=6

# 连续失败达到该次数后自动暂停该 webhook
# WEBHOOK_AUTO_PAUSE_FAILURES=20

# ========================================
# 九、Updater 服务（自动更新）
# ========================================
# Updater 认证令牌（生成方式：openssl rand -hex 32）
# 后端与 updater 容器通过此令牌校验请求签名
FLOWMIND_UPDATER_TOKEN=your_updater_service_token_here

# 后端访问 updater 服务的地址（docker compose 环境下由 compose 文件提供）
# UPDATER_URL=http://updater:8090

# 项目目录与状态目录（docker compose 环境下由 compose 文件提供）
# FLOWMIND_PROJECT_DIR=
# FLOWMIND_UPDATE_STATE_DIR=/state
# COMPOSE_PROJECT_NAME=flowmind

# 更新后健康检查地址
# FLOWMIND_BACKEND_HEALTH_URL=http://backend:8000/api/health
# FLOWMIND_FRONTEND_HEALTH_URL=http://frontend/

# 版本发布来源（格式 owner/repo）
# FLOWMIND_RELEASE_REPOSITORY=lxfight/flowmind

# GitHub 加速代理（逗号分隔；留空使用内置默认代理，off 关闭）
# FLOWMIND_GITHUB_ACCELERATORS=

# Git 拉取超时与低带宽判定（秒/字节每秒）
# FLOWMIND_GIT_FETCH_TIMEOUT=45
# FLOWMIND_GIT_LOW_SPEED_LIMIT=100
# FLOWMIND_GIT_LOW_SPEED_TIME=30

# 镜像拉取重试与超时
# FLOWMIND_PULL_RETRIES=3
# FLOWMIND_PULL_RETRY_DELAY=3
# FLOWMIND_PULL_TIMEOUT=1800

# Docker Registry 镜像仓库（逗号分隔；off 关闭），主仓库不可达时作为回退
# FLOWMIND_IMAGE_REGISTRY_MIRRORS=

# 允许在有本地修改时继续更新（自动 stash，更新后恢复）
# FLOWMIND_ALLOW_DIRTY_UPDATE=false

# 更新前磁盘剩余空间最低要求（字节，默认 1GB）
# FLOWMIND_UPDATE_MIN_FREE_BYTES=1073741824

# ========================================
# 十、构建镜像源（中国网络加速，可选）
# ========================================
# deploy.sh 的镜像源选择模式：auto（自动测速）/ official（官方）/ china（国内）
# FLOWMIND_MIRROR_MODE=auto

# 测速结果缓存文件（可选）
# FLOWMIND_MIRROR_CACHE_FILE=

# 手动指定构建源（留空则按 MIRROR_MODE 自动选择）
# PYPI_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
# DEBIAN_MIRROR=http://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine
