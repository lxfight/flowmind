# FlowMind 环境变量配置
# 复制此文件为 .env 并根据需要修改

# ---- 数据库 ----
# PostgreSQL + pgvector（推荐，需要 Docker）
DATABASE_URL=postgresql+asyncpg://flowmind:flowmind_secret@localhost:5432/flowmind

# 本地开发无 Docker 时使用 SQLite（注释上面这行，取消下面这行的注释）
# DATABASE_URL=sqlite+aiosqlite:///./flowmind.db

# ---- Docker 宿主机端口 ----
# 只修改 .env，不要直接修改 docker-compose.yml，以免阻止自动更新。
# POSTGRES_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=80

# ---- JWT 鉴权 ----
# 生产环境务必设置一个随机字符串（可用 openssl rand -hex 32 生成）
# 留空则自动生成随机密钥（每次重启会变化，仅用于开发测试）
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- 外部通知 ----
# 用于加密 Webhook 签名密钥；生产环境必须设置并在后端与 notifier 之间保持一致。
# 修改此值会导致已有集成密钥无法解密（可在集成页面重新生成）。
INTEGRATION_ENCRYPTION_KEY=
# 通知中生成的 FlowMind 绝对链接，例如 https://flowmind.example.com；留空则发送相对路径。
PUBLIC_APP_URL=
# WEBHOOK_REQUEST_TIMEOUT=10
# WEBHOOK_WORKER_POLL_SECONDS=1
# WEBHOOK_MAX_ATTEMPTS=6
# WEBHOOK_AUTO_PAUSE_FAILURES=20

# ---- 应用时区 ----
# LLM 助手感知当前时间所用的时区（服务器运行在 UTC）。
# 决定「今天/明天/本周」等相对时间的换算以及任务截止日期的归属。
APP_TIMEZONE=Asia/Shanghai

# ---- 管理员 ----
# 首次启动时若无用户，自动创建默认超级管理员
# 用户名只在首次初始化时生效，创建后不可修改
# FLOWMIND_ADMIN_USERNAME=admin
# 密码要求 8-128 位；不设置时随机生成并仅在首次启动日志中显示
# FLOWMIND_ADMIN_PASSWORD=your-admin-password

# ---- 应用版本与更新 ----
# 正式部署由 Release 版本控制；本地源码构建保持 local/0.4.0 即可。
# FLOWMIND_VERSION=0.4.0
# FlowMind 发布镜像的仓库前缀，不含协议和末尾斜杠。
# 默认从 ghcr.io 拉取；使用保留上游路径的代理时可设为 mirror.example/ghcr.io。
# 命令行更新与管理页面内更新都会自动使用此配置。
# FLOWMIND_IMAGE_REGISTRY=ghcr.io
# updater 拥有独立 Docker 权限，生产环境必须替换为随机值（openssl rand -hex 32）。
# FLOWMIND_UPDATER_TOKEN=replace-with-a-random-secret
# RELEASE_REPOSITORY=lxfight/flowmind
# 可选：只读 GitHub Token，可提高 Release 检查 API 配额。
# GITHUB_TOKEN=github_pat_read_only
# GitHub 官方 Git 拉取失败时按顺序尝试；设为 off 可禁用第三方加速源。
# FLOWMIND_GITHUB_ACCELERATORS=https://edgeone.gh-proxy.com,https://hk.gh-proxy.com,https://gh-proxy.com,https://gh.dpik.top
# 单个 Git 拉取源的超时时间，范围 15-300 秒。
# FLOWMIND_GIT_FETCH_TIMEOUT=45
# 慢网络下放宽 git 低速度判断（字节/秒 与 持续秒数），避免活连接被误判超时。
# FLOWMIND_GIT_LOW_SPEED_LIMIT=100
# FLOWMIND_GIT_LOW_SPEED_TIME=30
# 镜像拉取失败后的自动重试次数与基础退避秒数（docker pull 可续传分层）。
# FLOWMIND_PULL_RETRIES=3
# FLOWMIND_PULL_RETRY_DELAY=3
# 主镜像仓库（ghcr.io）不可达时的镜像加速仓库列表（逗号分隔）；留空禁用。
# 示例：FLOWMIND_IMAGE_REGISTRY_MIRRORS=https://docker.m.daocloud.io,https://dockerproxy.net
# FLOWMIND_IMAGE_REGISTRY_MIRRORS=
# 本地已修改 tracked 文件时，允许更新前自动 git stash、更新后尝试恢复（默认拒绝更新）。
# 冲突时修改会保留在 stash 中，不会丢失。FLOWMIND_ALLOW_DIRTY_UPDATE=true 启用。
# FLOWMIND_ALLOW_DIRTY_UPDATE=false
# 数据库备份完成后仍需保留的最小可用空间，默认 1 GiB。
# FLOWMIND_UPDATE_MIN_FREE_BYTES=1073741824

# ---- Docker 构建镜像源 ----
# scripts/deploy.sh 默认测速后自动选择官方源或国内源，也可强制指定：
# FLOWMIND_MIRROR_MODE=auto
# 可选值：auto / official / china
# 自动探测结果会缓存；网络环境变化后用 --refresh-mirrors 重新测速。
# 以下地址通常无需手工配置；显式设置后会优先于自动探测结果。
# PYPI_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org
# DEBIAN_MIRROR=http://deb.debian.org/debian
# DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
# ALPINE_MIRROR=https://dl-cdn.alpinelinux.org/alpine

# ---- 速率限制 ----
# 登录防暴力破解：每个用户名+IP组合在时间窗口内的最大尝试次数
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_WINDOW=60

# ---- LLM 配置（可选） ----
# 默认使用 OpenAI 兼容 API，可以配置为任何兼容的服务
# LLM_API_KEY=sk-your-api-key-here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# 报告生成总时限包含全部重试；仅对限流、服务异常、网络错误和不完整输出重试。
# LLM_REPORT_TIMEOUT=180
# LLM_REPORT_MAX_RETRIES=2
# LLM_REPORT_RETRY_BASE_DELAY=1

# ---- LLM Embedding 配置（RAG 知识库） ----
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# Embedding 接口可与 chat 分别部署（例如本地向量服务 + 云端 chat）。
# 以下两项留空时，embedding 调用自动回退使用 LLM_API_KEY / LLM_BASE_URL：
# EMBEDDING_API_KEY=sk-your-embedding-key-here
# EMBEDDING_BASE_URL=https://your-embedding-endpoint/v1

# ---- RAG 配置 ----
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K_RETRIEVAL=5

# ---- 调试模式 ----
# DEBUG=false

# ---- 文件上传 ----
# UPLOAD_DIR=uploads
# AVATAR_MAX_BYTES=2097152
# KNOWLEDGE_MAX_BYTES=26214400
